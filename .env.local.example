# ─────────────────────────────────────────────
# Resolution Nation — Environment Variables
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────

# Supabase (find these in your Supabase project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Anthropic (for AI-powered goal generation in Phase 2+)
ANTHROPIC_API_KEY=your_anthropic_api_key

# CRON_SECRET — required by /api/cron/hard-delete-accounts.
# Generate with:   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Or with openssl: openssl rand -base64 48 | tr -d '\n+/' | cut -c1-64
# The same value MUST be set in your Vercel project environment
# variables (Settings → Environment Variables) so the nightly
# cron can authenticate against the route.
CRON_SECRET=generate_a_random_string_and_paste_here
