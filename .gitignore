# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/

# libreoffice lock files + scratch
.~lock*
.write-test

# business documents — keep local, never commit
Resolution_Nation_*.docx
Resolution_Nation_*.xlsx
Resolution_Nation_Publication_Package.md

# Credentials, financial, and legal documents — NEVER commit.
# Deny-by-default on PDFs: this repo has held bank 2FA backup codes and the
# EIN letter in the project root, one `git add -A` away from being permanent
# git history. Add an explicit `!` exception below if a PDF ever needs tracking.
*.pdf
*backup-code*
*backup_code*
*recovery-code*
*recovery_code*
*-EIN*
secrets/
credentials/
